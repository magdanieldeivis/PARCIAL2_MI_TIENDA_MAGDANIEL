# Variables de entorno públicas para la aplicación Mi Tienda
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env'
# 2. Reemplaza los valores con la URL y la Anon/Publishable Key de tu proyecto en Supabase
# 3. NUNCA coloques una Secret Key (service_role) ni contraseñas aquí

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_anon_publishable_key_aqui
